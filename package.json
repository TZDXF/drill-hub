{
  "name": "drill-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:shared && pnpm --filter @drill-hub/web build:dev && pnpm --parallel --filter @drill-hub/server --filter @drill-hub/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && pnpm typecheck:tools",
    "test": "vitest run",
    "test:docker": "tsx scripts/test-docker.ts",
    "dev:web": "pnpm build:shared && pnpm --filter @drill-hub/web dev:vite",
    "dev:server": "pnpm build:shared && pnpm --filter @drill-hub/server dev",
    "dev:mobile": "pnpm build:shared && pnpm --filter @drill-hub/mobile dev",
    "build:shared": "pnpm --filter @drill-hub/contracts build && pnpm --filter @drill-hub/api-client build",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "typecheck:tools": "tsc -p tsconfig.tools.json"
  },
  "devDependencies": {
    "@drill-hub/contracts": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/unzip-stream": "0.3.4",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "unzip-stream": "0.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.4.1"
}
