# Docker Compose pulls the daily build by default; no local source build is needed.
# To pin a tested build, replace nightly with its nightly-<date>-<commit>-<run>-<attempt> tag.
# DRILL_HUB_IMAGE=ghcr.io/tzdxf/drill-hub:nightly

# Development defaults to 0.0.0.0 so other devices on the LAN can connect.
# Production deployments outside Docker should normally use 127.0.0.1 behind a reverse proxy.
# Docker Compose should keep HOST=0.0.0.0 so published ports can reach the container.
HOST=0.0.0.0
PORT=3000
DATABASE_PATH=.data/drill-hub.sqlite
# Both docker-compose.yml (published image) and docker-compose.dev.yml (build from source) contain
# the full application and database configuration, with SQLite enabled by default.
#   Production:      docker compose up -d
#   Development:     docker compose -f docker-compose.dev.yml up -d
# To switch to PostgreSQL: set DATABASE_DRIVER=postgres and POSTGRES_PASSWORD below, then
# uncomment the postgres service and its volume in the Compose file you use.
# DATABASE_DRIVER=sqlite
# DATABASE_URL=postgres://drill_hub:CHANGE_ME@postgres:5432/drill_hub
# Password for the bundled Compose postgres service; required when that service is uncommented.
# POSTGRES_PASSWORD=
# Production may use HTTP or HTTPS. Prefer HTTPS, especially for public deployments.
# NODE_ENV=production
# Public deployment base for Agent instructions and Skill ZIP links; does not change client API connections.
# HTTP/HTTPS only; optional path prefix is preserved and requires matching proxy/frontend deployment.
# Do not append /api/v1, credentials, query parameters, or fragments. Trailing slashes are removed.
# Empty/unset only permits a loopback request Host; LAN/public/proxy deployments MUST set PUBLIC_URL.
# Loopback addresses work only on that host, not for remote Agents. Invalid values prevent startup.
# PUBLIC_URL=https://study.example.org
# Development may leave this empty; a persistent key is generated in .data/dev-encryption-key.
# Production requires an explicit 32-byte key (64 hex characters). Generate one with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Set the generated value below and back it up securely; losing it prevents decrypting stored credentials.
# DRILL_HUB_ENCRYPTION_KEY=
# Optional one-time administrator bootstrap; no built-in password.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# All browser origins are allowed, including credentialed requests; there is no origin whitelist.
# Only trust the IP/CIDR of the actual reverse proxy; never trust the whole Internet.
# TRUSTED_PROXIES=127.0.0.1,::1
# Default false. Set true only for trusted deployments needing private/local model servers.
# ALLOW_PRIVATE_MODEL_URLS=false
# Operational API/login logs only; never removes business audit or grading history.
# ACCESS_LOG_RETENTION_DAYS=7
