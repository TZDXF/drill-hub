# Development defaults to 0.0.0.0 so other devices on the LAN can connect.
# Production deployments outside Docker should normally use 127.0.0.1 behind a reverse proxy.
# Docker Compose should keep HOST=0.0.0.0 so published ports can reach the container.
HOST=0.0.0.0
PORT=3000
DATABASE_PATH=.data/drill-hub.sqlite
# Production may use HTTP or HTTPS. Prefer HTTPS, especially for public deployments.
# NODE_ENV=production
# Public deployment base for Agent instructions and Skill ZIP links; does not change client API connections.
# HTTP/HTTPS only; optional path prefix is preserved and requires matching proxy/frontend deployment.
# Do not append /api/v1, credentials, query parameters, or fragments. Trailing slashes are removed.
# Empty/unset uses the request protocol and Host (not forwarded headers); configure explicitly behind a proxy.
# Loopback addresses work only on that host, not for remote Agents. Invalid values prevent startup.
# PUBLIC_URL=https://study.example.org
# Development may leave this empty; a persistent key is generated in .data/dev-encryption-key.
# Production requires an explicit 32-byte key (64 hex characters). Generate one with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Set the generated value below and back it up securely; losing it prevents decrypting stored credentials.
# DRILL_HUB_ENCRYPTION_KEY=
# Optional one-time administrator bootstrap; no built-in password.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
