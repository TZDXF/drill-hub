{
  "name": "@drill-hub/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#contracts/*.vue": "./src/*.vue",
    "#contracts/*.json": "./src/*.json",
    "#contracts/*.js": "./src/*.ts",
    "#contracts/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@drill-hub/tsconfig": "workspace:*"
  }
}
