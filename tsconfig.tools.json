{
  "extends": "@drill-hub/tsconfig/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "#server/*": ["apps/server/src/*"],
      "#server-root/*": ["apps/server/*"],
      "#learning-client/*": ["packages/learning-client/src/*"],
      "#mobile/*": ["apps/mobile/src/*"],
      "#api-client/*": ["packages/api-client/src/*"]
    }
  },
  "include": [
    "vitest.config.ts",
    "playwright.config.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "apps/server/test/**/*.ts",
    "apps/mobile/test/**/*.ts",
    "packages/api-client/test/**/*.ts",
    "packages/learning-client/test/**/*.ts"
  ]
}
