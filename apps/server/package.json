{
  "name": "@drill-hub/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#server/*": {
      "types": "./src/*",
      "development": "./src/*",
      "default": "./dist/*"
    },
    "#server-root/*": "./*"
  },
  "scripts": {
    "dev": "pnpm --workspace-root exec tsx watch --conditions=development --env-file-if-exists=.env apps/server/src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "pnpm --workspace-root exec node --env-file-if-exists=.env apps/server/dist/index.js",
    "test": "vitest run",
    "admin:create": "pnpm --workspace-root exec tsx --conditions=development --env-file-if-exists=.env apps/server/src/cli.ts"
  },
  "dependencies": {
    "@drill-hub/contracts": "workspace:*",
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@earendil-works/pi-mcp": "1.4.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "11.2.1",
    "better-sqlite3": "12.4.1",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "typeorm": "0.3.31",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@drill-hub/tsconfig": "workspace:*",
    "@types/better-sqlite3": "9.6.0",
    "@types/pg": "8.23.1"
  }
}
