{
  "name": "@drill-hub/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#web/*.vue": "./src/*.vue",
    "#web/*.json": "./src/*.json",
    "#web/*.js": "./src/*.ts",
    "#web/*": "./src/*.ts"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "dev:vite": "vite --host 0.0.0.0",
    "build:dev": "vite build --mode development",
    "build:watch": "vite build --watch --mode development",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@drill-hub/contracts": "workspace:*",
    "@drill-hub/learning-client": "workspace:*",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@drill-hub/tsconfig": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-vue": "6.0.10",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
